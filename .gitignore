node_modules/
dist/
build/
coverage/
.next/
# Pre-incident-fix backup of a corrupted production build (2026-08-27) -
# preserved on disk for forensics only, kept until the new isolated
# release mechanism has survived at least one real production deployment.
apps/web/.next.broken-*/
*.log
*.tsbuildinfo
.env
.env.local
.DS_Store

# Job workspaces and generated artifacts are never source-controlled
jobs/
outputs/
previews/
checkpoints/

# Preflight reports contain machine-specific details; not committed
DYO-Preflight-Report.txt

# Real client reference assets (video, project files, work maps) - never committed
local-inputs/

# Windows worker deployment runtime - regenerated on demand via
# `npm run package:windows-worker` (scripts/package-windows-worker.mjs),
# same as every other dist/ in this repo. Never hand-edited or committed.
deploy/windows-worker/worker-app/

# Per-build stamp (commit hash + timestamp) written into each packaged zip -
# regenerated on every build, never committed.
deploy/windows-worker/BUILD-ID.txt

# Packaged client zips - built on demand, never committed.
deploy/*.zip

# Production deployment key material and lock file - never committed, same
# convention as /opt/dashboard-dyo-app's .deploy-tools/. The private key
# lives only on the production server and in the GitHub Actions secret.
.deploy-tools/
.deploy.lock
.deploy-build.*
/.deployed-sha

# Marks THIS checkout as the live production checkout - created once,
# out-of-band, only on the production server. Never present in a CI
# checkout, a fresh clone, a developer's machine, or an isolated release
# worktree - see scripts/guard-production-web-build.mjs.
/.production-checkout
