# Contabo/API
DATABASE_URL=postgresql://user:password@db:5432/dyo
DYO_PUBLIC_URL=https://your-domain.example

# apps/api runtime (Phase 1)
API_HOST=0.0.0.0
API_PORT=4000
# Shared secret required to call POST /api/workers/register (see docs/AUDIT.md
# and apps/api/src/infrastructure/auth/pairing-secret.ts). Generate a real
# random value for each environment - never reuse this placeholder.
WORKER_REGISTRATION_SECRET=replace-me-with-a-long-random-value
WORKER_HEARTBEAT_STALE_AFTER_MS=30000
LOG_LEVEL=info

# Windows worker
DYO_API_URL=https://your-domain.example
WORKER_ID=worker-001
WORKER_TOKEN=replace-me
WORK_ROOT=C:\DYO-Agent
AE_PATH=C:\Program Files\Adobe\Adobe After Effects 2026\Support Files\AfterFX.exe
AERENDER_PATH=C:\Program Files\Adobe\Adobe After Effects 2026\Support Files\aerender.exe
AE_MCP_PATH=C:\AI-Tools\ae-mcp
WORKER_MAX_CONCURRENCY=1
