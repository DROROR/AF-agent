# Contabo/API
DATABASE_URL=postgresql://user:password@db:5432/dyo
DYO_PUBLIC_URL=https://your-domain.example

# apps/api runtime (Phase 1)
API_HOST=0.0.0.0
API_PORT=4000
# Shared secret required to call POST /api/workers/register (see docs/AUDIT.md
# and apps/api/src/infrastructure/auth/pairing-secret.ts). Generate a real
# random value for each environment - never reuse this placeholder.
WORKER_REGISTRATION_SECRET=replace-me-with-a-long-random-value
WORKER_HEARTBEAT_STALE_AFTER_MS=30000
LOG_LEVEL=info

# Windows worker (apps/worker, Phase 2) - see docs/WINDOWS-WORKER.md
DYO_API_URL=https://your-domain.example
WORKER_NAME=client-worker-1
# Leave WORKER_ID/WORKER_TOKEN unset for first-time pairing (see
# WORKER_REGISTRATION_SECRET below). Once paired, the worker persists its
# issued credentials locally and these are not required again - only set
# both here if you are pre-provisioning credentials out of band.
WORKER_ID=
WORKER_TOKEN=
# One-time pairing secret - must match the API's WORKER_REGISTRATION_SECRET
# above. Only needed for the worker's first run; never required again after
# that (or at all, if WORKER_ID/WORKER_TOKEN are pre-provisioned instead).
WORKER_REGISTRATION_SECRET=replace-me-with-a-long-random-value
WORK_ROOT=C:\DYO-Agent
AE_PATH=C:\Program Files\Adobe\Adobe After Effects 2026\Support Files\AfterFX.exe
AERENDER_PATH=C:\Program Files\Adobe\Adobe After Effects 2026\Support Files\aerender.exe
AE_MCP_PATH=C:\AI-Tools\ae-mcp
HEARTBEAT_INTERVAL_MS=15000

# Shotstack renderer POC (packages/renderer) - EXPERIMENTAL, not wired into
# any production path. See docs/RENDERER-ARCHITECTURE.md and
# docs/SHOTSTACK-POC.md. Never commit a real key - get one from
# https://dashboard.shotstack.io (sandbox keys are free).
SHOTSTACK_API_KEY=replace-me-with-a-real-shotstack-api-key
SHOTSTACK_ENV=sandbox
