{
  "name": "dyo-video-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -b tsconfig.solution.json && npm --workspace apps/web run typecheck",
    "test": "vitest run",
    "build": "tsc -b tsconfig.solution.json && npm --workspace apps/web run build",
    "db:generate": "npm --workspace @dyo/database run db:generate",
    "db:migrate": "npm --workspace @dyo/database run db:migrate",
    "shotstack:typography-smoke-test": "tsx scripts/shotstack/typography-smoke-test.ts"
  },
  "dependencies": {
    "@dyo/renderer": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
